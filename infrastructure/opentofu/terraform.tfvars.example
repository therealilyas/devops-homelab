# Copy this file to terraform.tfvars locally.
# terraform.tfvars is ignored by Git.

# Confirm these addresses are outside your router's DHCP pool before using them.
k8s_cp01_ipv4 = "192.168.1.201/24"
k8s_w01_ipv4  = "192.168.1.202/24"
k8s_w02_ipv4  = "192.168.1.203/24"

# Paste ONLY your PUBLIC key here. Never put a private key in this repository.
ssh_public_key = "ssh-ed25519 AAAA... your-user@workstation"
